# 密钥只留在 Host 环境中。可以使用已经存在的网关环境文件。
# DSH_DECISION_ENV_FILE=/absolute/path/to/existing/.env.dev
# 或直接配置：
AI_GATEWAY_BASE_URL=https://ai-gateway.qcc.com/api/v1
AI_GATEWAY_API_KEY=
# 可选：包含模型路由、价格和能力的本地 JSON 配置（示例见 models.example.json）。
# DSH_DECISION_MODELS_FILE=/absolute/path/to/models.local.json
# 只有开发预览使用此存储目录；DSH 中使用当前 Profile 的 storageDomain。
# DSH_DECISION_DATA_DIR=.decision-room
# DSH_DECISION_PORT=4318
