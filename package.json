{
  "name": "dsh-decision-room",
  "version": "0.9.4",
  "description": "DSH 多模型决策室：独立评审、持续质询、证据与分歧、方案修订及人工续议",
  "private": false,
  "author": "Jinhang Shi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinhangShi/dsh-decision-room.git"
  },
  "homepage": "https://github.com/JinhangShi/dsh-decision-room#readme",
  "bugs": {
    "url": "https://github.com/JinhangShi/dsh-decision-room/issues"
  },
  "keywords": [
    "dsh",
    "decision-support",
    "multi-agent",
    "multi-model",
    "deliberation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "models.example.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "smoke:live": "node scripts/live-smoke.mjs",
    "check": "pnpm test && pnpm build && pnpm typecheck",
    "test:e2e": "pnpm build && node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0",
    "dsh": ">=0.1.1-rc.2"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.17.1 <0.19.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "4.5.4",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.25.12",
    "playwright": "1.51.1",
    "prettier": "3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2"
  }
}
